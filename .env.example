# Qloo hackathon key (header X-Api-Key). Leave empty to run on synthetic mock data.
QLOO_API_KEY=
# Force mock data even when a key is set (1 = on).
QLOO_MOCK=
# Default: https://hackathon.api.qloo.com
QLOO_BASE_URL=

# Gemini (function calling). Without it the agent runs a scripted plan.
GEMINI_API_KEY=
# Defaults to gemini-flash-latest. Pin a specific Flash model ID if you prefer.
GEMINI_MODEL=
# Optional: tried after repeated overload (503/429) errors from GEMINI_MODEL.
GEMINI_FALLBACK_MODEL=

# Upstash Redis / Vercel KV for permalinks, rate limits and the Qloo cache.
# Without these, an in-memory store is used (fine locally, not on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reverse geocoding for neighbourhood names (OpenStreetMap Nominatim). Set to "off" to disable.
NOMINATIM=
NOMINATIM_USER_AGENT=sponsor-scout/0.1 (contact: you@example.com)

# New agent runs per IP per hour (cached runs are free).
RUNS_PER_HOUR=12

# Product name shown in the UI.
NEXT_PUBLIC_APP_NAME=Sponsor Scout
